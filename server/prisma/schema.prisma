// FR-008: Database Schema — aligned with SPEC-FASE-1.md §4.2
// Prisma schema for campus GPS routes with PostGIS geospatial support

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// Campus route connecting two points of interest
model Route {
  id          String   @id @default(cuid())
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  waypoints Waypoint[]
  segments  RouteSegment[]

  @@map("routes")
}

/// Point of interest along a route
model Waypoint {
  id           String       @id @default(cuid())
  waypointId   String       @unique @map("waypoint_id")
  name         String
  description  String
  waypointType WaypointType @map("waypoint_type")
  latitude     Float
  longitude    Float
  orderIndex   Int          @map("order_index")

  // FR-205: Transport connection data
  transportType  TransportType? @map("transport_type")
  transportLines String[]       @default([]) @map("transport_lines")

  routeId String @map("route_id")
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // FR-201: Graph edge relations
  edgesFrom GraphEdge[] @relation("EdgesFrom")
  edgesTo   GraphEdge[] @relation("EdgesTo")

  @@map("waypoints")
}

/// Segment of a route between two waypoints
model RouteSegment {
  id              String      @id @default(cuid())
  segmentId       String      @unique @map("segment_id")
  name            String
  surfaceType     SurfaceType @map("surface_type")
  elevationChange Float       @default(0) @map("elevation_change")
  riskLevel       RiskLevel   @default(none) @map("risk_level")
  geometryGeoJson String      @map("geometry_geojson") @db.Text
  orderIndex      Int         @map("order_index")

  // FR-304: Detailed risk assessment
  riskDescription  String?  @map("risk_description")
  riskFactors      String[] @default([]) @map("risk_factors")
  audioDescription String?  @map("audio_description")

  // FR-401: Physical accessibility for reduced mobility
  hasRamp        Boolean @default(false) @map("has_ramp")
  hasStairs      Boolean @default(false) @map("has_stairs")
  pathWidth      Float   @default(2.0)   @map("path_width")
  maxSlope       Float   @default(0.0)   @map("max_slope")
  surfaceQuality String  @default("good") @map("surface_quality")

  routeId String @map("route_id")
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  // FR-506: Temporary blocking due to incidents
  temporarilyBlocked Boolean @default(false) @map("temporarily_blocked")
  blockReason        String? @map("block_reason")

  // FR-201: Graph edges derived from this segment
  graphEdges GraphEdge[]

  // FR-501: Incidents reported on this segment
  incidents      Incident[]
  // FR-505: Push notification subscriptions
  subscriptions  PushSubscription[]

  @@map("route_segments")
}

/// FR-201: Graph edge connecting two waypoints with weighted cost
model GraphEdge {
  id             String   @id @default(cuid())
  fromWaypointId String   @map("from_waypoint_id")
  toWaypointId   String   @map("to_waypoint_id")
  segmentId      String?  @map("segment_id")
  distance       Float    // meters
  weight         Float    // calculated cost (distance + accessibility factors)
  bidirectional  Boolean  @default(true)

  fromWaypoint Waypoint      @relation("EdgesFrom", fields: [fromWaypointId], references: [id])
  toWaypoint   Waypoint      @relation("EdgesTo", fields: [toWaypointId], references: [id])
  segment      RouteSegment? @relation(fields: [segmentId], references: [id])

  @@unique([fromWaypointId, toWaypointId])
  @@map("graph_edges")
}

// FR-205: Transport type for transport_stop waypoints
enum TransportType {
  metro
  bus
  intercambiador
  cercanias

  @@map("transport_type")
}

enum WaypointType {
  entrance
  intersection
  building
  transport_stop
  landmark
  hazard
  rest_area
  information_point

  @@map("waypoint_type")
}

enum SurfaceType {
  paved
  cobblestone
  gravel
  dirt
  tactile

  @@map("surface_type")
}

enum RiskLevel {
  none
  low
  medium
  high

  @@map("risk_level")
}

// FR-501: Incident type categorization
enum IncidentType {
  obras
  obstaculo_temporal
  superficie_danada
  ascensor_averiado
  rampa_bloqueada
  otro

  @@map("incident_type")
}

// FR-501: Incident lifecycle status
enum IncidentStatus {
  pending
  validated
  rejected
  resolved

  @@map("incident_status")
}

/// FR-501: User-reported incident on a route segment
model Incident {
  id          String         @id @default(cuid())
  deviceId    String         @map("device_id")
  type        IncidentType
  status      IncidentStatus @default(pending)
  title       String
  description String
  latitude    Float
  longitude   Float
  photoUrl    String?        @map("photo_url")

  // FR-503: AI validation results
  aiValidation     Boolean?  @map("ai_validation")
  aiConfidence     Float?    @map("ai_confidence")
  aiReason         String?   @map("ai_reason")
  validationSource String?   @map("validation_source")

  // Linked segment (optional)
  segmentId   String?        @map("segment_id")
  segment     RouteSegment?  @relation(fields: [segmentId], references: [id])

  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  resolvedAt  DateTime?      @map("resolved_at")

  @@index([status])
  @@index([segmentId])
  @@index([deviceId])
  @@map("incidents")
}

/// FR-505: Push notification subscription
model PushSubscription {
  id        String       @id @default(cuid())
  deviceId  String       @map("device_id")
  pushToken String       @map("push_token")
  segmentId String       @map("segment_id")
  segment   RouteSegment @relation(fields: [segmentId], references: [id])
  createdAt DateTime     @default(now()) @map("created_at")

  @@unique([deviceId, segmentId])
  @@index([segmentId])
  @@map("push_subscriptions")
}

// FR-008: Database Schema — aligned with SPEC-FASE-1.md §4.2
// Prisma schema for campus GPS routes with PostGIS geospatial support

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

/// Campus route connecting two points of interest
model Route {
  id          String   @id @default(cuid())
  name        String
  description String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  waypoints Waypoint[]
  segments  RouteSegment[]

  @@map("routes")
}

/// Point of interest along a route
model Waypoint {
  id           String       @id @default(cuid())
  waypointId   String       @unique @map("waypoint_id")
  name         String
  description  String
  waypointType WaypointType @map("waypoint_type")
  latitude     Float
  longitude    Float
  orderIndex   Int          @map("order_index")

  routeId String @map("route_id")
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("waypoints")
}

/// Segment of a route between two waypoints
model RouteSegment {
  id              String      @id @default(cuid())
  segmentId       String      @unique @map("segment_id")
  name            String
  surfaceType     SurfaceType @map("surface_type")
  elevationChange Float       @default(0) @map("elevation_change")
  riskLevel       RiskLevel   @default(none) @map("risk_level")
  geometryGeoJson String      @map("geometry_geojson") @db.Text
  orderIndex      Int         @map("order_index")

  routeId String @map("route_id")
  route   Route  @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@map("route_segments")
}

enum WaypointType {
  entrance
  intersection
  building
  transport_stop
  landmark
  hazard
  rest_area
  information_point

  @@map("waypoint_type")
}

enum SurfaceType {
  paved
  cobblestone
  gravel
  dirt
  tactile

  @@map("surface_type")
}

enum RiskLevel {
  none
  low
  medium
  high

  @@map("risk_level")
}
